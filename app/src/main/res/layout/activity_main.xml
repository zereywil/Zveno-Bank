<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- up layout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Search -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="2dp">

            <SearchView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#E0E0E0"
                android:queryHint="Поиск"
                android:iconifiedByDefault="false"
                android:padding="1dp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Шапка профиля -->
        <LinearLayout
            android:id="@+id/profile_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:baselineAligned="false">

            <!-- avatar -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:cardCornerRadius="24dp"
                app:cardBackgroundColor="@color/card_purple"
                app:cardElevation="2dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@android:drawable/ic_menu_edit"
                    android:padding="12dp"
                    app:tint="@android:color/white"
                    android:contentDescription="@string/cd_profile_avatar" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Name button -->
            <Button
                android:id="@+id/button"
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:background="@null"
                android:text="@string/user_name"
                android:paddingStart="-12dp"
                android:paddingEnd="12dp"
                android:textSize="24sp"
                android:textColor="@android:color/white" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Referal button -->
            <ImageView
                android:id="@+id/referral_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:src="@android:drawable/ic_menu_edit"
                app:tint="@color/card_purple"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_referral" />

        </LinearLayout>

    </LinearLayout>

    <!-- Scroll -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Balance -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="20dp"
                app:cardBackgroundColor="@color/card_purple"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/bank_name"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/balance_amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/balance_amount"
                        android:textColor="@android:color/white"
                        android:textSize="34sp"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/card_number"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="16dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Быстрые действия -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/quick_actions"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="18sp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:rowCount="2"
                android:columnCount="2"
                android:baselineAligned="false">

                <Button
                    android:id="@+id/btn_pay"
                    style="@style/ActionButtonStyle"
                    android:text="@string/pay" />

                <Button
                    android:id="@+id/btn_transfer"
                    style="@style/ActionButtonStyle"
                    android:text="@string/transfer" />

                <Button
                    android:id="@+id/btn_topup"
                    style="@style/ActionButtonStyle"
                    android:text="@string/top_up" />

                <Button
                    android:id="@+id/btn_more"
                    style="@style/ActionButtonStyle"
                    android:text="@string/history" />

            </GridLayout>

            <!-- Last operations -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/recent_operations"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="18sp"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/operation_cafe"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:text="@string/operation_cafe"
                android:textColor="@android:color/white"
                android:background="@color/button_gray"
                android:gravity="center|start"
                android:padding="16dp"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/operation_transfer"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:text="@string/operation_transfer"
                android:textColor="@android:color/white"
                android:background="@color/button_gray"
                android:gravity="center|start"
                android:padding="16dp"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/operation_topup"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:text="@string/operation_topup"
                android:textColor="@android:color/white"
                android:background="@color/button_gray"
                android:gravity="center|start"
                android:padding="16dp"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true"/>

        </LinearLayout>

    </ScrollView>

    <!-- Down layout -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#1E1E1E">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="12dp"
            android:baselineAligned="false">

            <!-- Главная -->
            <LinearLayout
                android:id="@+id/nav_home"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_menu_manage"
                    app:tint="@color/nav_active"
                    android:contentDescription="@string/cd_home" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nav_home"
                    android:textSize="12sp"
                    android:textColor="@color/nav_active"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Платежи -->
            <LinearLayout
                android:id="@+id/nav_payments"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_menu_send"
                    app:tint="@color/nav_inactive"
                    android:contentDescription="@string/cd_payments" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nav_payments"
                    android:textSize="12sp"
                    android:textColor="@color/nav_inactive"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Город -->
            <LinearLayout
                android:id="@+id/nav_city"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_menu_mylocation"
                    app:tint="@color/nav_inactive"
                    android:contentDescription="@string/cd_city" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nav_city"
                    android:textSize="12sp"
                    android:textColor="@color/nav_inactive"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Чат -->
            <LinearLayout
                android:id="@+id/nav_chat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_menu_edit"
                    app:tint="@color/nav_inactive"
                    android:contentDescription="@string/cd_chat" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nav_chat"
                    android:textSize="12sp"
                    android:textColor="@color/nav_inactive"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Витрина -->
            <LinearLayout
                android:id="@+id/nav_shop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_menu_gallery"
                    app:tint="@color/nav_inactive"
                    android:contentDescription="@string/cd_shop" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nav_shop"
                    android:textSize="12sp"
                    android:textColor="@color/nav_inactive"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>